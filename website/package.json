{
  "name": "sakurai-seminar-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Aiko Sakurai Seminar website (Kobe University GSICS) with student portal and admin console, hosted on AWS Amplify Gen 2.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p amplify/tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p amplify/tsconfig.json",
    "sandbox": "ampx sandbox"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.15.7",
    "aws-amplify": "^6.22.1",
    "dompurify": "^3.4.16",
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.900.0",
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.3"
  }
}
